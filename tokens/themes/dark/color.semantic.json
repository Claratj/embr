{
  "$description": "Dark mode (borrador 3): a token mode, never a component variant. The neutral ramp is slate green, the brand teal hue at low chroma (page #101717, raised #1D2828, subtle #2A3737, border #5A7775, muted #859F9E). One light orange, #F38362, does every orange text job (primary text, link, eyebrow, focus). brand.primary and the solid status fills are not overridden: they carry their own label colour, so the theme does not change their contrast. bg.inverse and the inverse-action trio are theme-invariant.",
  "bg": {
    "$type": "color",
    "page": {
      "$value": "{color.slate}"
    },
    "surface": {
      "$value": "{color.slateRaised}"
    },
    "subtle": {
      "$value": "{color.slateSubtle}"
    }
  },
  "text": {
    "$type": "color",
    "default": {
      "$value": "{color.cream}"
    },
    "muted": {
      "$value": "{color.slateMuted}"
    },
    "caption": {
      "$value": "{color.slateMuted}"
    },
    "heading": {
      "$value": "{color.sageLight}"
    }
  },
  "border": {
    "$type": "color",
    "default": {
      "$value": "{color.slateBorder}"
    },
    "subtle": {
      "$value": "{color.slateBorder}"
    }
  },
  "brand": {
    "$type": "color",
    "primaryText": {
      "$value": "{color.orangeLight}"
    },
    "link": {
      "$value": "{color.orangeLight}"
    },
    "linkHover": {
      "$value": "{color.orangeLightHover}"
    },
    "eyebrow": {
      "$value": "{color.orangeLight}"
    },
    "markFrame": {
      "$value": "{color.sageLight}"
    },
    "markScript": {
      "$value": "{color.orangeLight}"
    }
  },
  "focus": {
    "$type": "color",
    "ring": {
      "$value": "{color.orangeLight}"
    }
  },
  "status": {
    "$type": "color",
    "onNeutral": {
      "$value": "{color.slateMuted}"
    },
    "onInfo": {
      "$value": "{color.infoStrong}"
    }
  }
}
