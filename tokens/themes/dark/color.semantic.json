{
  "$description": "Dark palette — Phase 1 (bg/text/border/brand.link/focus.ring) plus Phase 2's status color contract (status.*Subtle/on*/​*Border below). `brand.primary`/`primaryStrong`/`accent` and the solid `status.<name>` fills are still NOT overridden: they're used with white text on top (4.5-6.3:1 regardless of theme), so theme doesn't change their contrast. The Subtle/on/Border trio IS re-tuned per theme — see tokens/color.semantic.json for the shared rationale and the contrast numbers per pair.",
  "bg": {
    "$type": "color",
    "page": { "$value": "{color.charcoal}" },
    "surface": { "$value": "{color.charcoalRaised}" },
    "subtle": { "$value": "{color.charcoalSubtle}" }
  },
  "text": {
    "$type": "color",
    "default": { "$value": "{color.cream}" },
    "muted": { "$value": "{color.grayLight}" },
    "onBrand": { "$value": "{color.white}" }
  },
  "border": {
    "$type": "color",
    "default": { "$value": "{color.charcoalBorder}" }
  },
  "brand": {
    "$type": "color",
    "link": {
      "$value": "{color.rustLight}",
      "$description": "Plain rust (light theme's link color) is 3.35:1 on the dark page — fails AA text. Re-tinted to 5.11:1."
    }
  },
  "focus": {
    "$type": "color",
    "ring": {
      "$value": "{color.magentaLight}",
      "$description": "Plain magenta is 2.54:1 on the dark page — fails WCAG 2.4.11's 3:1 floor for a focus indicator. Re-tinted to 4.30:1."
    }
  },
  "status": {
    "$type": "color",
    "neutralSubtle": { "$value": "{color.graySubtle}" },
    "onNeutral": { "$value": "{color.grayStrong}", "$description": "4.53:1 on neutralSubtle." },
    "neutralBorder": { "$value": "{color.grayBorder}", "$description": "3.11:1 on bg.page." },

    "infoSubtle": { "$value": "{color.tealSubtle}" },
    "onInfo": { "$value": "{color.tealStrong}", "$description": "4.60:1 on infoSubtle." },
    "infoBorder": { "$value": "{color.tealBorder}", "$description": "3.08:1 on bg.page." },

    "successSubtle": { "$value": "{color.greenSubtle}" },
    "onSuccess": { "$value": "{color.greenStrong}", "$description": "4.62:1 on successSubtle." },
    "successBorder": { "$value": "{color.greenBorder}", "$description": "3.02:1 on bg.page." },

    "warningSubtle": { "$value": "{color.amberSubtle}" },
    "onWarning": { "$value": "{color.amberStrong}", "$description": "4.55:1 on warningSubtle." },
    "warningBorder": { "$value": "{color.amberBorder}", "$description": "3.01:1 on bg.page." },

    "dangerSubtle": { "$value": "{color.crimsonSubtle}" },
    "onDanger": { "$value": "{color.crimsonStrong}", "$description": "4.66:1 on dangerSubtle." },
    "dangerBorder": { "$value": "{color.crimsonBorder}", "$description": "3.04:1 on bg.page." }
  }
}
