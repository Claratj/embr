{
  "color": {
    "$type": "color",
    "plum": { "$value": "#5A1545", "$description": "Brand: dark primary (name/CV)" },
    "magenta": { "$value": "#AA1355", "$description": "Brand: action accent" },
    "orange": { "$value": "#E5491E", "$description": "Brand: vivid accent, rules and details" },
    "rust": { "$value": "#C2380F", "$description": "Brand: links and bullets" },

    "cream": { "$value": "#FAF9F5", "$description": "Neutral: page background" },
    "white": { "$value": "#FFFFFF", "$description": "Neutral: surfaces (cards, tables)" },
    "charcoal": { "$value": "#1A1416", "$description": "Neutral: primary text" },
    "gray": { "$value": "#5C5858", "$description": "Neutral: secondary text" },
    "sand": { "$value": "#E7E3DC", "$description": "Neutral: soft borders on cream" },
    "linen": { "$value": "#F1EEE8", "$description": "Neutral: table zebra/hover" },

    "amber": { "$value": "#B45309", "$description": "Semantic base: warning" },
    "green": { "$value": "#15803D", "$description": "Semantic base: success" },
    "teal": {
      "$value": "#0F6E6D",
      "$description": "Semantic base: info, retuned to the brand teal (MyWeb's own 179° card-surface hue — not absent from the palette, just a different teal from the old 195° cool one)"
    },
    "crimson": {
      "$value": "#BE123C",
      "$description": "Semantic base: danger (distinct from the rust used for links)"
    },

    "graySubtle": { "$value": "#E6E5E5", "$description": "status.neutralSubtle fill (light)" },
    "grayStrong": { "$value": "#686464", "$description": "status.onNeutral foreground (light)" },
    "grayBorder": { "$value": "#948F8F", "$description": "status.neutralBorder (light)" },

    "tealSubtle": {
      "$value": "#BBF4F3",
      "$description": "status.infoSubtle fill (light). Retuned to brand teal."
    },
    "tealStrong": {
      "$value": "#0E7473",
      "$description": "status.onInfo foreground (light). 4.61:1 on infoSubtle."
    },
    "tealBorder": {
      "$value": "#14A1A0",
      "$description": "status.infoBorder (light). 3.00:1 on bg.page, 2.61:1 on infoSubtle."
    },

    "greenSubtle": { "$value": "#D3F8E1", "$description": "status.successSubtle fill (light)" },
    "greenStrong": { "$value": "#147B3A", "$description": "status.onSuccess foreground (light)" },
    "greenBorder": { "$value": "#1BA64F", "$description": "status.successBorder (light)" },

    "amberSubtle": { "$value": "#FDE2CE", "$description": "status.warningSubtle fill (light)" },
    "amberStrong": { "$value": "#A54C08", "$description": "status.onWarning foreground (light)" },
    "amberBorder": { "$value": "#E96C0C", "$description": "status.warningBorder (light)" },

    "crimsonSubtle": { "$value": "#FBD0DB", "$description": "status.dangerSubtle fill (light)" },
    "crimsonStrong": { "$value": "#BA123B", "$description": "status.onDanger foreground (light)" },
    "crimsonBorder": { "$value": "#F05C80", "$description": "status.dangerBorder (light)" },

    "terracottaCta": {
      "$value": "#CF3F17",
      "$description": "Filled CTA background. 4.55:1 vs bg.page; 4.80:1 with white text."
    },
    "terracottaCtaHover": {
      "$value": "#B5330D",
      "$description": "Filled CTA hover. 6.10:1 with white text."
    },
    "inkMuted": { "$value": "rgba(26, 20, 22, 0.7)", "$description": "Muted body text — 70% ink." },
    "inkCaption": {
      "$value": "rgba(26, 20, 22, 0.6)",
      "$description": "Captions — 60% ink. Phase 4 STOP 2: was 55% (3.97:1 on bg.page, 4.03:1 on bg.surface — both fail the 4.5:1 text floor). 60% clears it: 4.67:1 on bg.page, 4.75:1 on bg.surface."
    },
    "inkLine": {
      "$value": "rgba(26, 20, 22, 0.48)",
      "$description": "Hairline borders — 48% ink. Phase 4 STOP 1: was 12% (1.28:1 on both bg.page and bg.surface — far under the 3:1 control-boundary floor, `border.control` was never actually added as its own token). 48% clears it: 3.20:1 on bg.page, 3.24:1 on bg.surface. Also strengthens Tag's unselected border and Card's border (its only other consumers) — deliberate, not a side effect to avoid."
    },
    "cream2": {
      "$value": "#F3F0E7",
      "$description": "Subtle alt background (MyWeb's --color-bg-alt)."
    },
    "tealBrand": { "$value": "#0F6E6D", "$description": "Inverse surface (MyWeb's card colour)." },
    "sageLight": {
      "$value": "#CDE8E2",
      "$description": "Muted text on the inverse surface. 4.7:1 on tealBrand."
    },
    "amberLabel": {
      "$value": "#FFDFA0",
      "$description": "Label/eyebrow on the inverse surface. 4.7:1 on tealBrand."
    }
  }
