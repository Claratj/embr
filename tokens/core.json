{
  "space": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "24px" },
    "6": { "$value": "32px" },
    "7": { "$value": "48px" },
    "8": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "8px" },
    "lg": { "$value": "20px" },
    "full": { "$value": "9999px" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "heading": { "$value": ["Montserrat", "system-ui", "sans-serif"] },
      "body": { "$value": ["Mulish", "system-ui", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "extrabold": { "$value": 800 }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "12px" },
      "sm": { "$value": "14px" },
      "md": { "$value": "16px" },
      "lg": { "$value": "18px" },
      "xl": { "$value": "20px" },
      "2xl": { "$value": "24px" },
      "3xl": { "$value": "32px" },
      "4xl": { "$value": "40px" },
      "eyebrow": { "$value": "12px" },
      "caption": { "$value": "13px" },
      "body": { "$value": "15px" },
      "bodyLg": {
        "$value": "clamp(1rem, 0.25vw + 0.95rem, 1.0625rem)",
        "$description": "Fluid, copied verbatim from MyWeb — responds to the viewport, not just the page. ~16-17px."
      },
      "h4": {
        "$value": "clamp(1rem, 0.4vw + 0.9rem, 1.1875rem)",
        "$description": "Fluid, copied verbatim from MyWeb. ~16-19px."
      },
      "h3": {
        "$value": "clamp(1.1875rem, 0.7vw + 1rem, 1.5rem)",
        "$description": "Fluid, copied verbatim from MyWeb. ~19-24px."
      },
      "h2": {
        "$value": "clamp(1.5rem, 1.6vw + 1.05rem, 2.125rem)",
        "$description": "Fluid, copied verbatim from MyWeb. ~24-34px."
      },
      "h1": {
        "$value": "clamp(2rem, 3.4vw + 1rem, 3.25rem)",
        "$description": "Fluid, copied verbatim from MyWeb. ~32-52px."
      }
    },
    "lineHeight": {
      "$type": "number",
      "tight": { "$value": 1.05 },
      "snug": { "$value": 1.2 },
      "normal": { "$value": 1.6 }
    },
    "letterSpacing": {
      "$type": "dimension",
      "eyebrow": { "$value": "0.14em" },
      "tight": { "$value": "-0.02em" }
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": {
        "color": "#1A141614",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    },
    "md": {
      "$value": {
        "color": "#1A14161f",
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "12px",
        "spread": "-2px"
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "140ms" },
      "base": { "$value": "240ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": { "$value": [0.22, 1, 0.36, 1] }
    }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.5 }
  }
}
